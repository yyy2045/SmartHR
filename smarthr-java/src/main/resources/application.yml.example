# SmartHR Java Application Configuration Template
# Copy this file to application.yml and fill in your values

server:
  port: 8080

spring:
  application:
    name: smarthr-java

  datasource:
    url: jdbc:mysql://localhost:3306/smarthr?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: YOUR_MYSQL_USER
    password: YOUR_MYSQL_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
        format_sql: true

  data:
    redis:
      host: localhost
      port: 6379
      timeout: 6000ms

  servlet:
    multipart:
      enabled: true
      max-file-size: 10MB
      max-request-size: 10MB

jwt:
  secret: YOUR_JWT_SECRET_KEY_CHANGE_THIS_TO_A_LONG_RANDOM_STRING
  expiration: 86400000

logging:
  level:
    com.smarthr: DEBUG
    org.springframework.security: DEBUG

ai:
  service:
    url: ${AI_SERVICE_URL:http://localhost:8001}
