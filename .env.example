# ==================== Database ====================
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_USER=smarthr
MYSQL_PASSWORD=your_secure_mysql_password

# ==================== JWT ====================
JWT_SECRET=your_secure_jwt_secret_key_min_32_chars

# ==================== AI Service ====================
ENVIRONMENT=production
DEBUG=false
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_SERVICE_URL=http://localhost:8001
DOMAIN_NAME=hr.example.com

# ==================== RAG Providers ====================
# 阿里云轻量服务器演示验收必须使用宿主机挂载的本地 BGE 模型。
EMBEDDING_PROVIDER=local_bge
LOCAL_BGE_MODEL_PATH=/opt/smarthr/models/bge-base-zh-v1.5
ALLOW_MOCK_EMBEDDING=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-base-zh-v1.5
EMBEDDING_DIMENSIONS=768
RERANK_PROVIDER=hybrid
RERANK_BASE_URL=
RERANK_MODEL=bge-reranker-v2-m3
RAGAS_MODE=heuristic
EXPOSE_INTERNAL_RAG_TOOLS=false
